# Ambiente
NODE_ENV=development
API_PORT=3000
WEB_PORT=8080
APP_URL=http://localhost:3000
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VEMARI_ORGANIZATION_NAME=Vemari Empreendimentos
VEMARI_ORGANIZATION_SLUG=vemari

# PostgreSQL
POSTGRES_DB=vemari_whats
POSTGRES_USER=vemari
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_PORT=15432
DATABASE_URL=postgresql://vemari:troque-esta-senha-local@localhost:15432/vemari_whats?schema=public

# Redis
REDIS_PORT=16379
REDIS_URL=redis://localhost:16379

# Autenticação e criptografia
JWT_ACCESS_SECRET=desenvolvimento-local-altere-este-segredo-antes-de-publicar-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
DATA_ENCRYPTION_KEY_BASE64=ZGVzZW52b2x2aW1lbnRvLWxvY2FsLTMyLWJ5dGVzISE=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PUBLIC_REGISTRATION_ENABLED=true

# Seed inicial. Use senhas únicas, aleatórias e armazenadas em cofre de senhas.
# O seed não altera a senha de usuários já existentes.
SEED_USERS_JSON=[{"email":"admin@vemari.com.br","name":"Administrador Vemari","password":"SUBSTITUA_POR_SENHA_UNICA_01","role":"ADMIN"},{"email":"atendimento1@vemari.com.br","name":"Atendente 1","password":"SUBSTITUA_POR_SENHA_UNICA_02","role":"ATTENDANT"},{"email":"atendimento2@vemari.com.br","name":"Atendente 2","password":"SUBSTITUA_POR_SENHA_UNICA_03","role":"ATTENDANT"}]

# Meta WhatsApp Business Platform
# A versão v25.0 foi lançada em 18/02/2026. Mantenha configurável e revise o changelog antes de atualizar.
META_GRAPH_API_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_USE_MARKETING_MESSAGES_API=false
META_HTTP_TIMEOUT_MS=15000

# Auditoria
AUDIT_RETENTION_DAYS=1825

# Operação
LOG_LEVEL=info
PROMETHEUS_ENABLED=true
OUTBOUND_CONCURRENCY=5
WORKER_HEALTH_PORT=3001
CAMPAIGN_BATCH_SIZE=100
MAX_CSV_IMPORT_BYTES=10485760

# Proxy e produção
APP_DOMAIN=localhost

# Backup (não exponha a passphrase no compose ou Git)
POSTGRES_HOST=postgres
BACKUP_DIR=/var/backups/vemari
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_PASSPHRASE=
