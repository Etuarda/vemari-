{
  "name": "vemari-whats-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma interna da Vemari para campanhas e atendimento via WhatsApp Business Platform.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\"",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose stop postgres redis",
    "local:setup": "npm run infra:up && npm run prisma:generate && npm run prisma:migrate:deploy && npm run prisma:seed",
    "dev:api": "tsx watch apps/backend/src/main-api.ts",
    "dev:worker": "tsx watch apps/backend/src/main-worker.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run prisma:generate && npm run typecheck && npm run build:backend && npm run build:web",
    "build:backend": "tsup apps/backend/src/main-api.ts apps/backend/src/main-worker.ts --format cjs --platform node --target node20 --out-dir dist/backend --clean --sourcemap",
    "build:web": "vite build",
    "start:api": "node dist/backend/main-api.js",
    "start:worker": "node dist/backend/main-worker.js",
    "preview:web": "vite preview --host 0.0.0.0",
    "lint": "eslint apps prisma tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:dependencies": "npm audit --audit-level=high"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.2.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "^5.101.2",
    "argon2": "^0.44.0",
    "bullmq": "5.80.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.2",
    "ioredis": "^5.7.0",
    "lucide-react": "^0.468.0",
    "pino": "^9.9.4",
    "prom-client": "^15.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@nestjs/cli": "^11.0.10",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.6.2",
    "prisma": "6.19.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
